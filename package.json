{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "description": "Byte to Offer - Tech Interview Prep Platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/arvindri2005/Byte-to-Offer.git"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "dev:all": "concurrently -n \"NEXT,GENKIT\" -c \"cyan,magenta\" \"pnpm:dev\" \"pnpm:genkit:dev\"",
    "genkit:dev": "genkit start -- tsx src/lib/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/lib/ai/dev.ts",
    "build": "next build",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:win": "set ANALYZE=true && next build",
    "check": "pnpm validate",
    "clean": "rimraf .next .swc coverage dist out",
    "clean:all": "pnpm clean && rimraf node_modules",
    "start": "next start",
    "gen:component": "tsx scripts/generate-component.ts",
    "setup": "node scripts/setup.mjs",
    "lint": "eslint .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "validate": "concurrently -n \"TYPE,LINT,TEST\" -c \"blue,yellow,magenta\" \"pnpm:typecheck\" \"pnpm:lint\" \"pnpm:test\"",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@genkit-ai/googleai": "^1.27.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@serwist/next": "^9.4.2",
    "@serwist/precaching": "^9.4.2",
    "@serwist/sw": "^9.4.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "firebase": "^12.6.0",
    "genkit": "^1.27.0",
    "import-in-the-middle": "^1.15.0",
    "lucide-react": "^0.555.0",
    "next": "^16.0.10",
    "next-themes": "^0.4.6",
    "react": "^19.2.1",
    "react-day-picker": "^9.11.3",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.67.0",
    "react-is": "^19.2.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.5.1",
    "remark-gfm": "^4.0.1",
    "require-in-the-middle": "^7.5.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "use-debounce": "^10.0.6",
    "vaul": "^1.1.2",
    "zod": "^4.2.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "jest --bail --findRelatedTests --passWithNoTests"
    ]
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@next/bundle-analyzer": "^16.1.6",
    "@storybook/addon-a11y": "^10.1.9",
    "@storybook/addon-docs": "^10.1.9",
    "@storybook/addon-vitest": "^10.1.9",
    "@storybook/nextjs-vite": "^10.1.9",
    "@storybook/react": "^10.1.9",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitest/browser-playwright": "^4.0.15",
    "@vitest/coverage-v8": "^4.0.15",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.5",
    "eslint-plugin-boundaries": "^5.3.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-storybook": "^10.1.9",
    "eslint-plugin-unicorn": "^62.0.0",
    "genkit-cli": "^1.27.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.7",
    "playwright": "^1.57.0",
    "postcss": "^8",
    "rimraf": "^6.1.2",
    "serwist": "^9.4.2",
    "storybook": "^10.1.10",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.4.5",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
