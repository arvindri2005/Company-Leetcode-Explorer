rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Data: Strictly owner-only access
    match /users/{userId} {
      // Allow users to read/write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcollections (e.g., bookmarkedProblems, problemProgress, etc.)
      // Inherit the owner-only check
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Companies: Public Read, No Write (Admin only, but no admin currently)
    match /companies/{companyId} {
      allow read: if true;
      allow write: if false; 
    }

    // Problems: Public Read, No Write
    match /problems/{problemId} {
      allow read: if true;
      allow write: if false;
    }

    // Contact Messages: Public Create, No Read/Update/Delete
    // Added validation to prevent spam and invalid data
    match /contact-messages/{messageId} {
      allow create: if true
        && request.resource.data.keys().hasOnly(['name', 'email', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 100
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if false;
    }
  }
}
